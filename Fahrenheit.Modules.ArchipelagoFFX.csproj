<Project Sdk="Fahrenheit.Sdk/1.0.0-alpha10">

	<!-- ASSEMBLY BASIC PROPERTIES -->
	<PropertyGroup>
		<Version>0.8.0-alpha</Version>
		<FahrenheitVersion>v1.0.0-alpha10</FahrenheitVersion>
	</PropertyGroup>

	<!-- ASSEMBLY ADDITIONAL PROPERTIES -->
	<PropertyGroup>
		<AssemblyName>archipelago-ffx</AssemblyName>
		<AssemblyTitle>Fahrenheit Archipelago Mod for Final Fantasy X</AssemblyTitle>
		<Product>Fahrenheit Archipelago Mod for Final Fantasy X</Product>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
	</PropertyGroup>
	<ItemGroup>
		<Compile Remove="fh-mods-csr\**" />
		<EmbeddedResource Remove="fh-mods-csr\**" />
		<None Remove="fh-mods-csr\**" />
		
		<Compile Remove="custom-character\**" />
		<EmbeddedResource Remove="custom-character\**" />
		<None Remove="custom-character\**" />
		
		<Compile Remove="playable-seymour-mod\**" />
		<EmbeddedResource Remove="playable-seymour-mod\**" />
		<None Remove="playable-seymour-mod\**" />
	</ItemGroup>

	<!-- SHARED FILE LINKS -->
	<ItemGroup>
		<None Include="$(SolutionDir).editorconfig" Link=".editorconfig" />
	</ItemGroup>

    <!-- PACKAGE REFERENCES -->
	<ItemGroup>
		<PackageReference Include="Archipelago.MultiClient.Net" Version="6.7.1" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Update="Fahrenheit" Version="1.0.0-alpha10" />
	</ItemGroup>

	<PropertyGroup>
		<fhcsrName>fhcsr</fhcsrName>
		<fhcsrPath>$(ProjectDir)fh-mods-csr/</fhcsrPath>
		<fhcsrProject>$(fhcsrPath)Fahrenheit.Mods.CSR.csproj</fhcsrProject>

		<customCharacterName>custom-character</customCharacterName>
		<customCharacterPath>$(ProjectDir)custom-character/</customCharacterPath>
		<customCharacterProject>$(customCharacterPath)Fahrenheit.Mods.custom-character.csproj</customCharacterProject>

		<playableSeymourName>playable-seymour</playableSeymourName>
		<playableSeymourPath>$(ProjectDir)playable-seymour-mod/seymour/</playableSeymourPath>
		<playableSeymourProject>$(playableSeymourPath)Fahrenheit.Mods.playable-seymour.csproj</playableSeymourProject>
	</PropertyGroup>

	<!-- BUILD EVENTS -->
	<Target Name="ReplaceProperties" BeforeTargets="Publish">
		<PropertyGroup>
			<File>archipelago-ffx.manifest.json</File>
		</PropertyGroup>
		<WriteLinesToFile File="$(PublishDir)/$(File)" Lines="$([System.IO.File]::ReadAllText($(PublishDir)/$(File)).Replace('{Version}','$(Version)'))" Overwrite="true" Encoding="UTF-8" />
	</Target>

	<Target Name="DownloadFahrenheitRelease" AfterTargets="Publish">
		<PropertyGroup>
			<ReleaseUrl>https://github.com/fahrenheit-crew/fahrenheit/releases/download/$(FahrenheitVersion)/fahrenheit_windows_x86_release_$(FahrenheitVersion).zip</ReleaseUrl>
		</PropertyGroup>
		<Message Text="Downloading release from $(ReleaseUrl)..." />
		<DownloadFile SourceUrl="$(ReleaseURL)" DestinationFolder="$(PublishDir)" DestinationFileName="fh.zip" />
	</Target>

	<Target Name="ExtractFahrenheitRelease" AfterTargets="Publish">
		<Message Text="Extracting release from fh.zip..." />
		<Delete Files="$(PublishDir)fahrenheit" TreatErrorsAsWarnings="true" />
		<Unzip SourceFiles="$(PublishDir)fh.zip" DestinationFolder="$(PublishDir)fahrenheit" />
		<Delete Files="$(PublishDir)fh.zip" TreatErrorsAsWarnings="true" />
	</Target>

	<Target Name="CleanupFahrenheitRelease" AfterTargets="Publish">
		<Message Text="Cleanup unused Fahrenheit mods..." />
		<RemoveDir Directories="$(PublishDir)fahrenheit\mods" />
		<MakeDir Directories="$(PublishDir)fahrenheit\mods\$(AssemblyName)" />
		<MakeDir Directories="$(PublishDir)fahrenheit\mods\$(fhcsrName)" />
		<MakeDir Directories="$(PublishDir)fahrenheit\mods\$(customCharacterName)" />
		<MakeDir Directories="$(PublishDir)fahrenheit\mods\$(playableSeymourName)" />
	</Target>

	<Target Name="CopyAssets" AfterTargets="Publish">
		<PropertyGroup>
			<AssetsDir>$(ProjectDir)assets\</AssetsDir>
			<AssetsAPDir>$(AssetsDir)archipelago\</AssetsAPDir>
			<AssetsSeymourDir>$(AssetsDir)seymour\</AssetsSeymourDir>
			<LoadOrderFile>loadorder</LoadOrderFile>
			<LoadOrder>$(AssetsDir)$(LoadOrderFile)</LoadOrder>
			<StartGameFile>start_game.bat</StartGameFile>
			<StartGame>$(AssetsDir)$(StartGameFile)</StartGame>
			<AssetAPDestination>$(PublishDir)fahrenheit\mods\$(AssemblyName)</AssetAPDestination>
			<AssetSeymourDestination>$(PublishDir)fahrenheit\mods\$(playableSeymourName)</AssetSeymourDestination>
		</PropertyGroup>
		<ItemGroup>
			<AssetFiles Include="$(LoadOrder); $(StartGame)" />
		</ItemGroup>
		<Message Text="Copy solution assets..." />
		<Exec Condition="'$(OS)' == 'Windows_NT'" Command="powershell -Command &quot;robocopy '$(AssetsAPDir)' '$(AssetAPDestination)' /MIR /R:0 /W:0" ContinueOnError="true" IgnoreExitCode="true" />
		<Exec Condition="'$(OS)' == 'Windows_NT'" Command="powershell -Command &quot;robocopy '$(AssetsSeymourDir)' '$(AssetSeymourDestination)' /MIR /R:0 /W:0" ContinueOnError="true" IgnoreExitCode="true" />
		<Exec Condition="'$(OS)' == 'Unix'" Command="rsync -acu --delete '$(AssetsAPDir)/' '$(AssetAPDestination)'" ContinueOnError="true" IgnoreExitCode="true" />
		<Exec Condition="'$(OS)' == 'Unix'" Command="rsync -acu --delete '$(AssetsSeymourDir)/' '$(AssetSeymourDestination)'" ContinueOnError="true" IgnoreExitCode="true" />
		<Copy SourceFiles="@(AssetFiles)" DestinationFiles="$(PublishDir)fahrenheit\mods\$(LoadOrderFile); $(PublishDir)fahrenheit\$(StartGameFile)" ContinueOnError="true" />
	</Target>

	<Target Name="MoveFilesToFinalDestination" AfterTargets="Publish">
		<Message Text="Move project files to their final destination..." />
		<ItemGroup>
			<ProjectFiles Include="$(PublishDir)*.*" Exclude="**\**\" />
		</ItemGroup>
		<Move SourceFiles="@(ProjectFiles)" DestinationFolder="$(PublishDir)fahrenheit\mods\$(AssemblyName)\" />
	</Target>

	<Target Name="PublishCSR" AfterTargets="Publish">
		<Message Text="Publish fh-mods-csr" />
		<MSBuild Projects="$(fhcsrProject)" Properties="OutputPath=$(PublishDir)fahrenheit\mods\$(fhcsrName);Configuration=$(Configuration)" Targets="Build" />
	</Target>

	<Target Name="PublishCustomCharacter" AfterTargets="Publish">
		<Message Text="Publish custom-character" />
		<MSBuild Projects="$(customCharacterProject)" Properties="OutputPath=$(PublishDir)fahrenheit\mods\$(customCharacterName);Configuration=$(Configuration)" Targets="Build" />
	</Target>

	<Target Name="PublishPlayableSeymour" AfterTargets="Publish">
		<Message Text="Publish playable-seymour" />
		<MSBuild Projects="$(playableSeymourProject)" Properties="OutputPath=$(PublishDir)fahrenheit\mods\$(playableSeymourName);Configuration=$(Configuration)" Targets="Build" />
	</Target>
  
</Project>
